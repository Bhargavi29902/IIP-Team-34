# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///instance/followup.db

# AI: "mock" runs offline with a rule-based extractor (good for dev + CI).
# Set to "anthropic" and add a key to use the real LLM.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Google: "simulated" fakes Calendar/Gmail results and labels them as simulated in the UI.
# "live" needs OAuth set up (see README) and shows honest errors until then.
INTEGRATIONS_MODE=simulated
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

MASK_PERSONAL_DATA=true
SCHEDULER_ENABLED=true
DEMO_RETENTION_DAYS=30
